# ---- Copy this file to .env and fill in real values before running docker compose ----

# Postgres
POSTGRES_USER=rabe7
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=rabe7
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rabe7:change-me-in-production@postgres:5432/rabe7?schema=public

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=rabe7-storage
MINIO_ROOT_PASSWORD=change-me-in-production
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_BUCKET=rabe7-uploads
S3_ACCESS_KEY=rabe7-storage
S3_SECRET_KEY=change-me-in-production
S3_REGION=us-east-1

# Auth
JWT_ACCESS_SECRET=change-me-generate-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-generate-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# API
API_PORT=4000
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3000
NODE_ENV=development

# Admin (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
