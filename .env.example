# ---- Copy this file to .env and fill in real values before running docker compose ----

# Postgres
POSTGRES_USER=rabe7
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=rabe7
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rabe7:change-me-in-production@postgres:5432/rabe7?schema=public

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=rabe7-storage
MINIO_ROOT_PASSWORD=change-me-in-production
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
# Browser-facing address for the same storage server — S3_ENDPOINT above
# only resolves inside Docker, so product images need this separate,
# publicly-reachable URL to actually display in anyone's browser.
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=rabe7-uploads
S3_ACCESS_KEY=rabe7-storage
S3_SECRET_KEY=change-me-in-production
S3_REGION=us-east-1

# Auth
JWT_ACCESS_SECRET=change-me-generate-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-generate-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d
# Marks the login/session cookie "HTTPS only" — browsers silently refuse to
# store it if this is true but the site is loaded over plain http://, which
# breaks sign-in with no visible error. Leave false for now (local testing,
# or a server without a domain/SSL yet). Set to true once the site has a
# real domain with HTTPS — never leave it false on a public HTTPS site.
COOKIE_SECURE=false

# --- Domains (production only) ---
# Leave all of these unset for local development. Once a real domain's DNS
# points its subdomains at this server, set these so nginx-proxy (see
# docker-compose.yml) can route each app and acme-companion can request its
# Let's Encrypt certificate automatically — see docs/DEPLOYMENT.md section 7.
# Multiple hostnames for one app (e.g. the bare domain and "www") can be
# comma-separated: STOREFRONT_DOMAIN=yourdomain.com,www.yourdomain.com
# ADMIN_DOMAIN=admin.yourdomain.com
# STOREFRONT_DOMAIN=yourdomain.com
# DRIVER_DOMAIN=livreur.yourdomain.com
# SALES_DOMAIN=commercial.yourdomain.com
# API_DOMAIN=api.yourdomain.com
# Object storage (product photos, proof-of-delivery, shop photos) — update
# S3_PUBLIC_URL below to https://<this domain> once it has a certificate,
# or every image on an https:// page will fail to load (mixed content).
# STORAGE_DOMAIN=images.yourdomain.com
# Let's Encrypt sends renewal-failure notices here — use a real inbox you
# check, not a placeholder.
# LETSENCRYPT_EMAIL=you@yourdomain.com

# API
API_PORT=4000
# These four *_URL values are what the API's CORS check compares the
# browser's Origin header against — they must be the exact public address
# each app is actually loaded from. Once you have a domain (see section 7
# of docs/DEPLOYMENT.md), swap "http://localhost:PORT" for the real
# "https://subdomain.yourdomain.com" for each — mismatching even the
# scheme (http vs https) makes every request from that app fail.
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3000
# The customer-facing storefront's browser-facing address — the API needs
# this to allow it to make signed-in requests (CORS), same reason it
# already needs ADMIN_URL.
STOREFRONT_URL=http://localhost:3001
# The driver app's browser-facing address — same CORS reason as
# STOREFRONT_URL above.
DRIVER_URL=http://localhost:3002
# The sales (prevente) app's browser-facing address — same CORS reason as
# STOREFRONT_URL above.
SALES_URL=http://localhost:3003
NODE_ENV=development

# Admin, storefront, driver, and sales (all Next.js) — every browser app
# calls the API at this same public address. Update the host once you're
# on a real domain, same as API_URL above (…/api/v1 stays either way).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Push notifications (optional — "new product" / "new promotion" alerts) ---
# Leave all of these unset to leave push notifications off; nothing else
# breaks. To enable: create a free Firebase project (console.firebase.google.com),
# add a Web App to it, and fill these in.
#
# Server-side (Project settings → Service accounts → Generate new private key —
# downloads a JSON file with these three values):
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the key's newlines escaped as literal \n, exactly as the downloaded
# JSON has them, all on one line, wrapped in quotes.
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
#
# Client-side (Project settings → General → Your apps → Web app → SDK setup):
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
# NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
# Project settings → Cloud Messaging → Web Push certificates → generate one:
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=B...
